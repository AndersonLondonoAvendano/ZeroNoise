# Dependency-Track connection
DT_BASE_URL=http://localhost:8080
DT_API_KEY=your-api-key-here

# MCP Server
MCP_SERVER_NAME=zeronoise
MCP_TRANSPORT=stdio   # stdio | sse
ANTHROPIC_API_KEY=your-anthropic-key-here   # Required for Stage 3 --analyze
STAGE3_CONFIDENCE_THRESHOLD=0.70            # Minimum confidence to allow Stage 3

# Security — optional, sensible defaults are set in config.py
MAX_FINDINGS_PER_RESPONSE=50        # Defensive pagination limit for Stage 1 responses
STAGE3_RATE_LIMIT_FETCH=200         # Max fetch_code_snippet calls per MCP session
STAGE3_RATE_LIMIT_FUNCTION=100      # Max get_function_context calls per MCP session
STAGE3_RATE_LIMIT_CALL=100          # Max get_call_context calls per MCP session
STAGE3_RATE_LIMIT_SYMBOL=50         # Max find_symbol_usages calls per MCP session
MCP_HOST=127.0.0.1                  # Binding host — relevant only when MCP_TRANSPORT=sse

# OWASP Dependency-Check fast-gate
GATE_CVSS_THRESHOLD=7.0             # Umbral CVSS para activar el fast-gate (v3 por defecto)
                                    # Si el CVE solo tiene CVSS v2, se usa con flag de revisión humana
